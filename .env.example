# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Cloudflare Turnstile (optional - for anti-spam on forms)
# Get from: https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Admin User (create this user in Supabase Auth dashboard)
# The admin email and password are configured in Supabase Auth, not here
# Just make sure to create the admin user in Supabase Auth after setup

# Email Notifications (optional - for future implementation)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# WhatsApp Business (optional - for future API integration)
# WHATSAPP_BUSINESS_TOKEN=your-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
