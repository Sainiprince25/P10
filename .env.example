# ============================================
# SUPABASE CONFIGURATION (Required)
# ============================================
# Get these from your Supabase project: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# CLOUDFLARE TURNSTILE (Recommended for production)
# ============================================
# Get from: https://dash.cloudflare.com/?to=/:account/turnstile
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# Server-side secret (set in Supabase Edge Function secrets, NOT in frontend)
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ============================================
# EMAIL NOTIFICATIONS (Optional)
# ============================================
# SMTP Configuration for email notifications
# For Gmail: Use App Password (not your regular password)
# Gmail App Passwords: https://myaccount.google.com/apppasswords

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=P.S Service Provider <your-email@gmail.com>

# Admin email to receive new enquiry notifications
# ADMIN_NOTIFICATION_EMAIL=admin@psserviceprovider.com

# Set these as Supabase Edge Function secrets:
# supabase secrets set SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=... SMTP_PASS=... ADMIN_NOTIFICATION_EMAIL=...

# ============================================
# WHATSAPP BUSINESS API (Optional - Future)
# ============================================
# WHATSAPP_BUSINESS_TOKEN=your-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# ============================================
# NOTES
# ============================================
# 1. VITE_ prefixed variables are exposed to the frontend (browser)
# 2. Non-VITE_ variables are server-side only (Edge Functions)
# 3. Edge Function secrets are set via: supabase secrets set KEY=VALUE
# 4. Never commit .env.local or .env files to git
# 5. In production, set environment variables in Vercel dashboard
